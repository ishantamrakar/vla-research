# Copy this file to slurm/cluster.env and fill in your values.
# cluster.env is gitignored — never committed.
#
# Usage: all slurm/*.slurm scripts source this file automatically.

# ---- Cluster identity ------------------------------------------------------
# Path to your large scratch / project storage (where repos and outputs live).
# Examples:
#   UMIACS Nexus:  /fs/nexus-scratch/<username>
#   Zaratan:       /scratch/zt1/<username>
#   Generic:       $HOME  (if no separate scratch)
SCRATCH=/fs/nexus-scratch/YOUR_USERNAME

# Where you cloned this repo (must be under $SCRATCH or somewhere bind-mounted)
REPO=$SCRATCH/projects/vla-research

# Where you cloned the sibling lerobot repo
LEROBOT=$SCRATCH/projects/lerobot

# ---- SLURM settings --------------------------------------------------------
# Check available partitions with: sinfo
PARTITION=scavenger
ACCOUNT=scavenger

# GPU type and count — check `sinfo -o "%P %G"` for available types
GPU_TYPE=l40s
GPU_COUNT=1

# Memory and CPUs
MEM=64G
CPUS=8

# Max wall time for training jobs (increase for very long runs)
TIME=1-00:00:00

# ---- W&B -------------------------------------------------------------------
# Leave blank if you use ~/.netrc (recommended).
# Set here if your cluster doesn't mount your home dir into the container.
WANDB_API_KEY=
