Bootstrap: docker
From: nvidia/cuda:12.6.0-devel-ubuntu24.04

%labels
    Author vla-research
    Description PyTorch cu126 + LeRobot + LIBERO training environment

%environment
    export DEBIAN_FRONTEND=noninteractive
    export UV_NO_PROGRESS=1
    export HF_HOME=${SCRATCH}/hf_cache
    export UV_CACHE_DIR=${SCRATCH}/uv_cache
    export PATH=/opt/uv:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        libgl1 \
        libgl1-mesa-dri \
        libgles2 \
        libglfw3 \
        libglew-dev \
        libosmesa6 \
        libosmesa6-dev \
        libglu1-mesa \
        patchelf \
        build-essential \
        cmake \
        ffmpeg \
        && rm -rf /var/lib/apt/lists/*

    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/opt/uv sh

    mkdir -p /root/.mujoco
    wget -q https://github.com/google-deepmind/mujoco/releases/download/2.3.7/mujoco-2.3.7-linux-x86_64.tar.gz \
        -O /tmp/mujoco.tar.gz
    tar -xzf /tmp/mujoco.tar.gz -C /root/.mujoco
    rm /tmp/mujoco.tar.gz
    echo 'export MUJOCO_GL=osmesa' >> /etc/environment
    echo 'export LD_LIBRARY_PATH=/root/.mujoco/mujoco-2.3.7/lib:$LD_LIBRARY_PATH' >> /etc/environment

    mkdir -p /workspace /lerobot

%runscript
    exec bash "$@"

%help
    VLA research container — PyTorch cu126, headless GL for LIBERO.

    Runtime bind mounts expected (set by slurm/train.slurm):
      $SCRATCH  → $SCRATCH  (identity mount: HF cache, uv cache, outputs)
      $HOME     → auto-mounted by Apptainer (.netrc, .gitconfig)

    First run on a new cluster node:
      apptainer exec --nv vla.sif bash -c "cd $REPO && uv sync"
